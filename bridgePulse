// MPU
uint8_t mpuAddress = 0;
uint8_t chipID = 0;

bool sensorOK = false;

float baselineX = 0;
float baselineY = 0;
float baselineZ = 1;

// READINGS
float angleChange = 0;
float temperatureC = 0;

float maxAngle = 0;
float maxTemperature = -100;

bool angleAlert = false;
bool tempAlert = false;
bool irDetected = false;

int angleCount = 0;
int tempCount = 0;
int irCount = 0;
int readFailures = 0;

