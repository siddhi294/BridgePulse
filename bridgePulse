enum BridgeStatus {
  NORMAL,
  ANGLE_WARNING,
  GROUND_WARNING,
  TEMP_WARNING,
  CRITICAL,
  SENSOR_ERROR
};

BridgeStatus status = SENSOR_ERROR;

// ============================================
// DIRECT I2C
// ============================================

bool writeReg(uint8_t reg, uint8_t val) {
  MPU.beginTransmission(mpuAddress);
  MPU.write(reg);
  MPU.write(val);
  return MPU.endTransmission() == 0;
}

bool readReg(uint8_t reg, uint8_t &val) {
  MPU.beginTransmission(mpuAddress);
  MPU.write(reg);

  if (MPU.endTransmission(false) != 0)
    return false;

  if (MPU.requestFrom(mpuAddress, (uint8_t)1) != 1)
    return false;

  val = MPU.read();
  return true;
}

// ============================================
// READ ACCELEROMETER AND TEMPERATURE
// ============================================

bool readSensor(
  float &x,
  float &y,
  float &z,
  float &temp
) {
  MPU.beginTransmission(mpuAddress);
  MPU.write(0x3B);

  if (MPU.endTransmission(false) != 0)
    return false;

  if (MPU.requestFrom(mpuAddress, (uint8_t)8) != 8)
    return false;

  int16_t ax = (int16_t)(
    (MPU.read() << 8) | MPU.read()
  );

  int16_t ay = (int16_t)(
    (MPU.read() << 8) | MPU.read()
  );

  int16_t az = (int16_t)(
    (MPU.read() << 8) | MPU.read()
  );

  int16_t rawTemp = (int16_t)(
    (MPU.read() << 8) | MPU.read()
  );

  x = ax / 16384.0f;
  y = ay / 16384.0f;
  z = az / 16384.0f;

  if (chipID == 0x70) {
    // MPU6500-family
    temp = rawTemp / 333.87f + 21.0f;
  } else {
    // MPU6050-family
    temp = rawTemp / 340.0f + 36.53f;
  }

  return true;
}

// ============================================
// INITIALIZE MPU
// ============================================

bool initializeMPU() {
  mpuAddress = 0;

  for (uint8_t a = 0x68; a <= 0x69; a++) {
    MPU.beginTransmission(a);

    if (MPU.endTransmission() == 0) {
      mpuAddress = a;
      break;
    }
  }

  if (!mpuAddress)
    return false;

  if (!readReg(0x75, chipID))
    return false;

  Serial.print("WHO_AM_I: 0x");
  Serial.println(chipID, HEX);

  if (chipID != 0x70 && chipID != 0x68)
    return false;

  if (!writeReg(0x6B, 0x00))
    return false;

  delay(200);

  if (!writeReg(0x1C, 0x00))
    return false;

  if (!writeReg(0x1B, 0x00))
    return false;

  if (!writeReg(0x1A, 0x04))
    return false;

  return true;
}

// ============================================
// CALIBRATION
// ============================================

bool calibrateMPU() {
  float sx = 0, sy = 0, sz = 0;
  int valid = 0;

  for (int i = 0; i < 100; i++) {
    float x, y, z, t;

    if (readSensor(x, y, z, t)) {
      sx += x;
      sy += y;
      sz += z;
      valid++;
    }

    delay(20);
  }

  if (valid < 80)
    return false;

  float x = sx / valid;
  float y = sy / valid;
  float z = sz / valid;

  float magnitude = sqrtf(x*x + y*y + z*z);

  if (magnitude < 0.1f)
    return false;

  baselineX = x / magnitude;
  baselineY = y / magnitude;
  baselineZ = z / magnitude;

  return true;
}

// ============================================
// ANGLE RELATIVE TO STARTING POSITION
// ============================================

float calculateAngle(float x, float y, float z) {
  float magnitude = sqrtf(x*x + y*y + z*z);

  if (magnitude < 0.1f)
    return NAN;

  x /= magnitude;
  y /= magnitude;
  z /= magnitude;

  float dot =
    x * baselineX +
    y * baselineY +
    z * baselineZ;

  dot = constrain(dot, -1.0f, 1.0f);

  return acosf(dot) * 180.0f / PI;
}

// ============================================
// STATUS TEXT
// ============================================

const char* statusText() {
  switch (status) {
    case NORMAL: return "NORMAL";
    case ANGLE_WARNING: return "ANGLE WARNING";
    case GROUND_WARNING: return "GROUND PROXIMITY";
    case TEMP_WARNING: return "HIGH TEMPERATURE";
    case CRITICAL: return "CRITICAL ALERT";
    default: return "SENSOR ERROR";
  }
}

// ============================================
// SENSOR UPDATE
// ============================================

void updateSensors() {
  bool rawIR = digitalRead(IR_PIN);

  bool detected =
    IR_ACTIVE_LOW ? !rawIR : rawIR;

  if (detected) {
    if (irCount < CONFIRM_COUNT)
      irCount++;
  } else {
    irCount = 0;
  }

  irDetected = irCount >= CONFIRM_COUNT;

  if (!sensorOK) {
    status = SENSOR_ERROR;
    return;
  }

  float x, y, z, temp;

  if (!readSensor(x, y, z, temp)) {
    readFailures++;

    if (readFailures >= 5) {
      sensorOK = false;
      status = SENSOR_ERROR;
    }

    return;
  }

  readFailures = 0;

  temperatureC = temp;

  float rawAngle = calculateAngle(x, y, z);

  if (isnan(rawAngle)) {
    sensorOK = false;
    status = SENSOR_ERROR;
    return;
  }

  angleChange =
    0.65f * angleChange +
    0.35f * rawAngle;

  if (angleChange > maxAngle)
    maxAngle = angleChange;

  if (temperatureC > maxTemperature)
    maxTemperature = temperatureC;

  // ANGLE WARNING
  if (angleChange >= ANGLE_LIMIT) {
    if (angleCount < CONFIRM_COUNT)
      angleCount++;
  } else {
    angleCount = 0;
  }

  angleAlert = angleCount >= CONFIRM_COUNT;

  // TEMPERATURE WARNING
  if (temperatureC >= TEMP_LIMIT) {
    if (tempCount < CONFIRM_COUNT)
      tempCount++;
  } else {
    tempCount = 0;
  }

  tempAlert = tempCount >= CONFIRM_COUNT;

  // PRIORITY
  int warnings =
    (angleAlert ? 1 : 0) +
    (tempAlert ? 1 : 0) +
    (irDetected ? 1 : 0);

  if (warnings >= 2)
    status = CRITICAL;
  else if (irDetected)
    status = GROUND_WARNING;
  else if (angleAlert)
    status = ANGLE_WARNING;
  else if (tempAlert)
    status = TEMP_WARNING;
  else
    status = NORMAL;
}

// ============================================
// LIVE DATA ENDPOINT
// ============================================

void sendData() {
  String json;
  json.reserve(320);

  json += "{";

  json += "\"angle\":";
  json += String(angleChange, 2);

  json += ",\"temperature\":";
  json += String(temperatureC, 2);

  json += ",\"maxAngle\":";
  json += String(maxAngle, 2);

  json += ",\"maxTemperature\":";
  json += String(maxTemperature, 2);

  json += ",\"ir\":";
  json += irDetected ? "true" : "false";

  json += ",\"angleAlert\":";
  json += angleAlert ? "true" : "false";

  json += ",\"tempAlert\":";
  json += tempAlert ? "true" : "false";

  json += ",\"sensorOK\":";
  json += sensorOK ? "true" : "false";

  json += ",\"uptime\":";
  json += String(millis() / 1000);

  json += ",\"status\":\"";
  json += statusText();
  json += "\"";

  json += "}";

  server.send(200, "application/json", json);
}

