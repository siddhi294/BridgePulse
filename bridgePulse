// ============================================
// GRAPH HISTORY
// 120 samples x 500ms = 60 seconds
// ============================================

const MAX_POINTS = 120;

const angleHistory = [];
const tempHistory = [];
const irHistory = [];

let lastDataTime = 0;
let busy = false;

// ============================================
// CHART RENDERER - NO EXTERNAL LIBRARIES
// ============================================

function drawChart(id, values, threshold, type) {
  const canvas = document.getElementById(id);
  const rect = canvas.getBoundingClientRect();

  const width = Math.max(100, rect.width);
  const height = Math.max(100, rect.height);

  const dpr = Math.min(window.devicePixelRatio || 1, 2);

  canvas.width = Math.round(width * dpr);
  canvas.height = Math.round(height * dpr);

  const ctx = canvas.getContext('2d');
  ctx.setTransform(dpr,0,0,dpr,0,0);

  const left = 42;
  const right = 12;
  const top = 14;
  const bottom = 30;

  const plotW = width - left - right;
  const plotH = height - top - bottom;

  let minY = 0;
  let maxY = 1;

  if (type === 'ir') {
    maxY = 1.2;
  } else if (type === 'angle') {
    maxY = Math.max(
      3,
      threshold * 1.5,
      ...values
    );
    maxY *= 1.1;
  } else {
    minY = Math.min(
      15,
      ...values
    ) - 2;

    maxY = Math.max(
      40,
      threshold + 4,
      ...values
    ) + 2;
  }

  function px(i) {
    return left +
      (i / (MAX_POINTS - 1)) * plotW;
  }

  function py(value) {
    return top + plotH -
      ((value - minY) / (maxY - minY)) * plotH;
  }

  ctx.clearRect(0,0,width,height);

  // Grid and Y labels

  ctx.font = '11px Arial';
  ctx.fillStyle = '#91b4a0';

  for (let i = 0; i <= 4; i++) {
    const y = top + (plotH / 4) * i;

    ctx.strokeStyle = '#284337';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(left,y);
    ctx.lineTo(width-right,y);
    ctx.stroke();

    const val = maxY -
      (maxY-minY) * i / 4;

    ctx.fillText(val.toFixed(1),4,y+4);
  }

  // Threshold line

  if (type !== 'ir') {
    const y = py(threshold);

    ctx.strokeStyle = '#ffc15c';
    ctx.lineWidth = 1.5;
    ctx.setLineDash([6,5]);

    ctx.beginPath();
    ctx.moveTo(left,y);
    ctx.lineTo(width-right,y);
    ctx.stroke();

    ctx.setLineDash([]);
  }

  // Actual readings

  if (values.length > 0) {
    ctx.beginPath();

    values.forEach((v,i) => {
      const x = px(MAX_POINTS-values.length+i);
      const y = py(v);

      if (i === 0) ctx.moveTo(x,y);
      else ctx.lineTo(x,y);
    });

    ctx.strokeStyle = '#5cffae';
    ctx.lineWidth = 2.5;
    ctx.lineJoin = 'round';
    ctx.lineCap = 'round';
    ctx.stroke();

    // Latest reading marker

    const last = values.length-1;

    ctx.fillStyle = '#5cffae';
    ctx.beginPath();
    ctx.arc(
      px(MAX_POINTS-values.length+last),
      py(values[last]),
      3.5,0,Math.PI*2
    );
    ctx.fill();
  }

  ctx.fillStyle = '#91b4a0';
  ctx.font = '11px Arial';

  ctx.fillText('60s ago',left,height-7);

  ctx.textAlign = 'right';
  ctx.fillText('Now',width-right,height-7);
  ctx.textAlign = 'left';
}

function renderCharts() {
  drawChart('angleChart',angleHistory,1.7,'angle');
  drawChart('tempChart',tempHistory,36,'temp');
  drawChart('irChart',irHistory,0,'ir');
}

function addSample(arr,value) {
  arr.push(value);

  if (arr.length > MAX_POINTS)
    arr.shift();
}

function setComparison(id,text,alert) {
  const el = document.getElementById(id);

  el.textContent = text;
  el.className = alert ? 'bad' : 'good';
}

// ============================================
// UPDATE DASHBOARD
// ============================================

async function updateDashboard() {
  if (busy) return;
  busy = true;

  try {
    const response = await fetch('/data',{
      cache:'no-store'
    });

    if (!response.ok)
      throw new Error('Network error');

    const d = await response.json();

    lastDataTime = Date.now();

    const angle = Number(d.angle);
    const temp = Number(d.temperature);

    document.getElementById('angle')
      .textContent = angle.toFixed(2);

    document.getElementById('temp')
      .textContent = temp.toFixed(2);

    document.getElementById('ground')
      .textContent = d.ir ? 'DETECTED' : 'CLEAR';

    document.getElementById('maxAngle')
      .textContent =
      Number(d.maxAngle).toFixed(2)+'°';

    document.getElementById('maxTemp')
      .textContent =
      Number(d.maxTemperature).toFixed(2)+'°C';

    document.getElementById('uptime')
      .textContent = d.uptime+' seconds';

    const warnings =
      Number(d.angleAlert) +
      Number(d.tempAlert) +
      Number(d.ir);

    document.getElementById('warnings')
      .textContent = warnings;

    setComparison(
      'angleCompare',
      angle.toFixed(2)+'°',
      d.angleAlert
    );

    setComparison(
      'tempCompare',
      temp.toFixed(2)+'°C',
      d.tempAlert
    );

    setComparison(
      'irCompare',
      d.ir ? 'DETECTED' : 'CLEAR',
      d.ir
    );

    const banner = document.getElementById('banner');
    const sub = document.getElementById('bannerSub');

    if (!d.sensorOK) {
      banner.className = 'banner error';
      banner.firstChild.textContent = 'SENSOR ERROR';
      sub.textContent = 'Check MPU connection';
    }
    else if (d.status === 'CRITICAL ALERT') {
      banner.className = 'banner danger';
      banner.firstChild.textContent = 'CRITICAL ALERT';
      sub.textContent = 'Multiple warnings detected';
    }
    else if (d.status === 'GROUND PROXIMITY') {
      banner.className = 'banner danger';
      banner.firstChild.textContent = 'GROUND PROXIMITY';
      sub.textContent = 'Inspect model bridge clearance';
    }
    else if (d.status === 'ANGLE WARNING') {
      banner.className = 'banner warn';
      banner.firstChild.textContent = 'ANGLE WARNING';
      sub.textContent = '1.7° threshold exceeded';
    }
    else if (d.status === 'HIGH TEMPERATURE') {
      banner.className = 'banner warn';
      banner.firstChild.textContent = 'HIGH TEMPERATURE';
      sub.textContent = 'MPU temperature reached 36°C';
    }
    else {
      banner.className = 'banner';
      banner.firstChild.textContent = 'BRIDGE NORMAL';
      sub.textContent = 'All monitored conditions normal';
    }

    document.getElementById('connection')
      .textContent = 'LIVE';

    document.getElementById('dot')
      .style.background = '#5cffae';

    // Only graph valid readings
    if (d.sensorOK) {
      addSample(angleHistory,angle);
      addSample(tempHistory,temp);
      addSample(irHistory,d.ir ? 1 : 0);
    }

    document.getElementById('samples')
      .textContent = angleHistory.length;

    renderCharts();

  } catch(error) {
    document.getElementById('connection')
      .textContent = 'OFFLINE';

    document.getElementById('dot')
      .style.background = '#ff6476';

    const banner = document.getElementById('banner');
    banner.className = 'banner error';
    banner.firstChild.textContent = 'CONNECTION LOST';

    document.getElementById('bannerSub')
      .textContent = 'Unable to reach ESP32';
  } finally {
    busy = false;
  }
}

// Update every 500ms
setInterval(updateDashboard,500);

window.addEventListener('resize',renderCharts);

renderCharts();
updateDashboard();

</script>
</body>
</html>
)rawliteral";

// ============================================
// WEBSITE ROUTES
// ============================================

void showPage() {
  server.send_P(
    200,
    "text/html",
    DASHBOARD
  );
}

// ============================================
// LCD
// ============================================

void updateLCD() {
  lcd.clear();

  switch (status) {
    case NORMAL:
      lcd.setCursor(0,0);
      lcd.print("BRIDGE NORMAL");
      lcd.setCursor(0,1);
      lcd.print("A:");
      lcd.print(angleChange,1);
      lcd.print(" T:");
      lcd.print(temperatureC,1);
      break;

    case ANGLE_WARNING:
      lcd.setCursor(0,0);
      lcd.print("ANGLE WARNING");
      lcd.setCursor(0,1);
      lcd.print("ANGLE:");
      lcd.print(angleChange,2);
      break;

    case GROUND_WARNING:
      lcd.setCursor(0,0);
      lcd.print("GROUND DETECTED");
      lcd.setCursor(0,1);
      lcd.print("CHECK CLEARANCE");
      break;

    case TEMP_WARNING:
      lcd.setCursor(0,0);
      lcd.print("HIGH TEMPERATURE");
      lcd.setCursor(0,1);
      lcd.print("TEMP:");
      lcd.print(temperatureC,1);
      lcd.print("C");
      break;

    case CRITICAL:
      lcd.setCursor(0,0);
      lcd.print("CRITICAL ALERT");
      lcd.setCursor(0,1);
      lcd.print("INSPECT BRIDGE");
      break;

    default:
      lcd.setCursor(0,0);
      lcd.print("SENSOR ERROR");
      lcd.setCursor(0,1);
      lcd.print("CHECK MPU");
      break;
  }
}

// ============================================
// SETUP
// ============================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  pinMode(IR_PIN,INPUT);

  Wire.begin(LCD_SDA,LCD_SCL);
  MPU.begin(MPU_SDA,MPU_SCL,100000);

  lcd.init();
  lcd.backlight();
  lcd.clear();
  lcd.print("BRIDGEPULSE 2.0");

  sensorOK = initializeMPU();

  if (sensorOK) {
    lcd.clear();
    lcd.print("CALIBRATING");
    lcd.setCursor(0,1);
    lcd.print("KEEP STILL");

    sensorOK = calibrateMPU();
  }

  if (sensorOK) {
    status = NORMAL;
    lcd.clear();
    lcd.print("SYSTEM READY");
    Serial.println("MPU READY");
  } else {
    status = SENSOR_ERROR;
    lcd.clear();
    lcd.print("SENSOR ERROR");
    Serial.println("MPU ERROR");
  }

  WiFi.mode(WIFI_AP);

  WiFi.softAP(
    WIFI_NAME,
    WIFI_PASS
  );

  server.on("/",showPage);
  server.on("/data",sendData);
  server.begin();

  Serial.println();
  Serial.println("BRIDGEPULSE 2.0 READY");
  Serial.print("Dashboard: http://");
  Serial.println(WiFi.softAPIP());
}

// ============================================
// LOOP
// ============================================

void loop() {
  server.handleClient();

  unsigned long now = millis();

  if (now-lastSample >= SAMPLE_MS) {
    lastSample = now;
    updateSensors();
  }

  if (now-lastLCD >= LCD_MS) {
    lastLCD = now;
    updateLCD();
  }
}
