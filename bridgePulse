#define LCD_ADDRESS 0x27
#define IR_ACTIVE_LOW true

// WARNING THRESHOLDS
const float ANGLE_LIMIT = 1.7f;
const float TEMP_LIMIT = 36.0f;

// THREE CONSECUTIVE READINGS TO CONFIRM
const int CONFIRM_COUNT = 3;

// TIMING
const unsigned long SAMPLE_MS = 50;
const unsigned long LCD_MS = 500;

// DEVICES
TwoWire MPU = TwoWire(1);
LiquidCrystal_I2C lcd(LCD_ADDRESS, 16, 2);
WebServer server(80);

